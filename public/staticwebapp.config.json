{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/art/*", "/*.svg", "/*.js", "/*.css", "/*.webmanifest"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "microphone=(), camera=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/art/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ]
}
